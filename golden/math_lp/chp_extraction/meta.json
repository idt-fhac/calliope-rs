          {
            "expression": "flow_out_inc_eff[carriers=electricity] == sum(flow_in_inc_eff, over=carriers)",
            "where": "turbine_type==backpressure AND NOT boiler_eff"
          }
        ],
        "foreach": [
          "nodes",
          "techs",
          "timesteps"
        ],
        "slices": {},
        "sub_expressions": {},
        "title": "",
        "where": "base_tech==conversion AND NOT include_storage==true"
      },
      "chp_backpressure_line_min": {
        "active": true,
        "description": "Set the backpressure line as a lower bound for electricity generation in combined heat and power plants with extraction turbines. `power_to_heat_ratio` is also referred to as the `backpressure ratio` or simply `cb`.\n",
        "equations": [
          {
            "expression": "flow_out[carriers=electricity] >= flow_out[carriers=heat] * power_to_heat_ratio\n",
            "where": "True"
          }
        ],
        "foreach": [
          "nodes",
          "techs",
          "timesteps"
        ],
        "slices": {},
        "sub_expressions": {},
        "title": "",
        "where": "turbine_type==extraction"
      },
      "chp_extraction_line": {
        "active": true,
        "description": "Set the extraction line for combined heat and power plants with extraction turbines. `power_loss_factor` is also referred to as simply `cv`.\n",
        "equations": [
          {
            "expression": "flow_out[carriers=electricity] <= (sum(flow_in_inc_eff, over=carriers) * flow_out_eff[carriers=electricity])\n   - (flow_out[carriers=heat] * power_loss_factor)\n",
            "where": "True"
          }
        ],
        "foreach": [
          "nodes",
          "techs",
          "timesteps"
        ],
        "slices": {},
        "sub_expressions": {},
        "title": "",
        "where": "turbine_type==extraction"
      }
    }
