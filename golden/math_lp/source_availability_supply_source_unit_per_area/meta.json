  "lp_file": "source_availability_supply_source_unit_per_area.lp",
  "math_dict": {
    "constraints": {
      "source_availability_supply": {
        "active": true,
        "description": "Set the upper bound on, or a fixed total of, a `supply` technology's ability to consume its available resource.",
        "equations": [
          {
            "expression": "source_use == source_use_equals * $source_scaler",
            "where": "source_use_equals"
          },
          {
            "expression": "source_use <= source_use_max * $source_scaler",
            "where": "NOT source_use_equals AND source_use_max"
          }
        ],
        "foreach": [
          "nodes",
          "techs",
          "timesteps"
        ],
        "slices": {},
        "sub_expressions": {
          "source_scaler": [
            {
              "expression": "area_use",
              "where": "source_unit==per_area"
            },
            {
              "expression": "sum(where(flow_cap, carrier_out), over=carriers)",
              "where": "source_unit==per_cap"
            },
            {
              "expression": "1",
              "where": "source_unit==absolute"
            }
          ]
        },
        "title": "",
        "where": "source_use AND (source_use_equals OR source_use_max)"
      }
    },
    "variables": {
      "area_use": {
        "active": true,
        "bounds": {
          "max": "area_use_max",
          "min": "area_use_min"
        },
        "default": 0,
        "description": "The area in space utilised directly (e.g., solar PV panels) or indirectly (e.g., biofuel crops) by a technology.",
        "domain": "real",
        "foreach": [
          "nodes",
          "techs"
        ],
        "title": "Area utilisation",
        "unit": "area",
        "where": "(area_use_min OR area_use_max OR area_use_per_flow_cap OR sink_unit==per_area OR source_unit==per_area)"
      },
      "flow_cap": {
        "active": true,
        "bounds": {
          "max": "flow_cap_max",
          "min": "flow_cap_min"
        },
        "default": 0,
        "description": "A technology's flow capacity, also known as its nominal or nameplate capacity.",
        "domain": "real",
        "foreach": [
          "nodes",
          "techs",
          "carriers"
        ],
        "title": "Technology flow (a.k.a. nominal) capacity",
        "unit": "power",
        "where": "carrier_in OR carrier_out"
      },
      "source_use": {
        "active": true,
        "bounds": {
          "max": Infinity,
          "min": 0
        },
        "default": 0,
        "description": "The carrier flow consumed from outside the system boundaries by a `supply` technology.",
        "domain": "real",
        "foreach": [
          "nodes",
          "techs",
          "timesteps"
        ],
        "title": "Source flow use",
        "unit": "energy",
        "where": "base_tech==supply"
      }
    }
  },
