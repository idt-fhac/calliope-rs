  "math_dict": {
    "constraints": {
      "balance_transmission": {
        "active": true,
        "description": "Fix the relationship between between carrier flowing into and out of a `transmission` link in each timestep.",
        "equations": [
          {
            "expression": "sum(flow_out_inc_eff, over=[nodes, carriers]) == sum(flow_in_inc_eff, over=[nodes, carriers])",
            "where": "True"
          }
        ],
        "foreach": [
          "techs",
          "timesteps"
        ],
        "slices": {},
        "sub_expressions": {},
        "title": "",
        "where": "base_tech==transmission"
      }
    },
    "global_expressions": {
      "flow_in_inc_eff": {
        "active": true,
        "default": 0,
        "description": "Inflows after taking efficiency losses into account.",
        "equations": [
          {
            "expression": "flow_in * flow_in_eff * flow_in_eff_per_distance ** distance",
            "where": "base_tech==transmission"
          },
          {
            "expression": "flow_in * flow_in_eff",
            "where": "NOT base_tech==transmission"
          }
        ],
        "foreach": [
          "nodes",
          "techs",
          "carriers",
          "timesteps"
        ],
        "order": 0,
        "slices": {},
        "sub_expressions": {},
        "title": "Carrier inflow including losses",
        "unit": "energy",
        "where": "flow_in"
      },
      "flow_out_inc_eff": {
        "active": true,
        "default": 0,
        "description": "Outflows after taking efficiency losses into account.",
        "equations": [
          {
            "expression": "flow_out / (\n  flow_out_eff * flow_out_parasitic_eff *\n  flow_out_eff_per_distance ** distance\n)",
            "where": "base_tech==transmission"
          },
          {
            "expression": "flow_out / (flow_out_eff * flow_out_parasitic_eff)",
            "where": "NOT base_tech==transmission"
          }
        ],
        "foreach": [
          "nodes",
          "techs",
          "carriers",
          "timesteps"
        ],
        "order": 0,
        "slices": {},
        "sub_expressions": {},
        "title": "Carrier outflow including losses",
        "unit": "energy",
        "where": "flow_out"
      }
    },
